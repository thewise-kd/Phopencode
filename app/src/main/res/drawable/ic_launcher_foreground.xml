<?xml version="1.0" encoding="utf-8"?>
<!--
    Phopencode mark: a phone whose screen holds a terminal prompt (">_").
    Drawn on the 108 dp adaptive canvas; everything stays inside the 66 dp safe zone.
    Colours come from core:ui's teal palette (Teal90 frame and prompt, Teal10 screen).
    docs/assets/logo.svg is the same mark; change both together.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Phone frame, with the screen and the speaker slot cut out. -->
    <path
        android:fillColor="#9CF1F0"
        android:fillType="evenOdd"
        android:pathData="M43,25 H65 A7,7 0 0 1 72,32 V76 A7,7 0 0 1 65,83 H43 A7,7 0 0 1 36,76 V32 A7,7 0 0 1 43,25 Z M43,32 H65 A3,3 0 0 1 68,35 V74 A3,3 0 0 1 65,77 H43 A3,3 0 0 1 40,74 V35 A3,3 0 0 1 43,32 Z M51,27.5 H57 A1,1 0 0 1 57,29.5 H51 A1,1 0 0 1 51,27.5 Z" />
    <!-- Screen. -->
    <path
        android:fillColor="#002020"
        android:pathData="M43,32 H65 A3,3 0 0 1 68,35 V74 A3,3 0 0 1 65,77 H43 A3,3 0 0 1 40,74 V35 A3,3 0 0 1 43,32 Z" />
    <!-- Prompt: ">" and "_". -->
    <path
        android:pathData="M45,48 L51.5,54.5 L45,61 M54.5,61 H62"
        android:strokeColor="#9CF1F0"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
