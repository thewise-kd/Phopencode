<resources>
    <!-- What screen readers say for the status icon of a tool call. -->
    <string name="chat_tool_status_pending">Bekliyor</string>
    <string name="chat_tool_status_running">Çalışıyor</string>
    <string name="chat_tool_status_done">Bitti</string>
    <string name="chat_tool_status_failed">Başarısız</string>
    <string name="chat_tool_status_unknown">Bilinmeyen durum</string>
