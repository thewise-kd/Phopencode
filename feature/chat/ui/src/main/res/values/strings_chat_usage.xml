    <plurals name="chat_usage_tokens">
        <item quantity="one">%1$s token</item>
        <item quantity="other">%1$s tokens</item>
    </plurals>
    <!-- %1$s: the percentage of the model's context in use, formatted for the language, such as "45%". -->
