    <string name="chat_actions_confirm_compact_title">Compact this session?</string>
    <string name="chat_actions_confirm_compact_message">The server summarizes the conversation so far, and the model continues from the summary. This can take a while.</string>
    <string name="chat_actions_confirm_compact">Compact</string>
    <string name="chat_actions_confirm_fork_title">Fork this session?</string>
    <string name="chat_actions_confirm_fork_message">A new session starts with a copy of the whole conversation, and the chat switches to it. This session stays as it is.</string>
    <string name="chat_actions_confirm_fork_here_title">Fork from here?</string>
    <string name="chat_actions_confirm_fork_here_message">A new session starts with the conversation before this message, and the chat switches to it. This session stays as it is.</string>
    <string name="chat_actions_confirm_fork">Fork</string>
